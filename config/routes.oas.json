          "id": {
            "type": "string",
            "format": "uuid"
          },
          "service_id": {
            "type": "string",
            "format": "uuid"
          },
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cout": {
            "type": "string",
            "nullable": true
          },
          "delai": {
            "type": "string",
            "nullable": true
          },
          "lieu": {
            "type": "string",
            "nullable": true
          },
          "infoComplementaire": {
            "type": "string",
            "nullable": true
          },
          "ordre": {
