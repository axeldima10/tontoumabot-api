{
  "openapi": "3.0.3",
  "info": {
    "title": "Tontouma Bot — API des 5 User Stories prioritaires",
    "version": "1.0.0",
    "description": "Sous-ensemble filtré de tontouma-bot-api-contract-COMPLET.yaml, limité aux endpoints strictement nécessaires aux 5 US du backlog MVP (3 Must Have, 2 Nice to Have — Form Builder). US2 (chat IA) : seul /access-ticket est ici — le canal conversationnel lui-même (texte SSE / voix WebSocket) est un contrat séparé, voir tontouma-bot-ai-service-contract.md, car il n'est pas exposé par ce backend Spring (architecture par ticket, v3)."
  },
  "servers": [
    {
      "url": "https://api.tontoumabot.sn/api/v1",
      "description": "Production (à confirmer)"
    },
    {
      "url": "http://localhost:8080/api/v1",
      "description": "Développement local"
    }
  ],
  "security": [
    {
      "clerkAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "clerkAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Header: Authorization: Bearer <token Clerk>. Absent sur /public/... et /access-ticket."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Organization": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "clerk_org_id": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "adresse": {
            "type": "string"
          },
          "telephone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "siteWeb": {
            "type": "string"
          },
          "logo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "statut": {
            "type": "string",
            "enum": [
              "active",
              "suspendue"
            ]
          },
          "dateCreation": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthenticatedUser": {
        "type": "object",
        "properties": {
          "clerk_user_id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "super_admin",
              "admin"
            ]
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          }
        }
      },
      "AccessResolution": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          }
        }
      },
      "ServiceOffering": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "departement_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "localisation": {
            "type": "string"
          },
          "telephone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
