            "format": "uuid"
          },
          "procedure_id": {
            "type": "string",
            "format": "uuid"
          },
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "actif": {
            "type": "boolean"
          },
          "statut": {
            "type": "string",
            "enum": [
              "brouillon",
              "publie"
            ]
          }
        }
      },
      "SectionFormulaire": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "formulaire_id": {
            "type": "string",
            "format": "uuid"
          },
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ordre": {
            "type": "integer"
          }
        }
